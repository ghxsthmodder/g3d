    </geometry>
    <primitive id="primitive" geometry="geom" material="mat_default"/>
  </mesh>
  <materials><material id="mat_default" name="Default"><pbr workflow="metallicRoughness"><baseColor r="0.72" g="0.72" b="0.72" a="1"/><metallic value="0"/><roughness value="0.8"/></pbr></material></materials>
  <scene><node id="root"><mesh ref="primitive"/></node></scene>
