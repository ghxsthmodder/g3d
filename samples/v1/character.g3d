<?xml version="1.0" encoding="UTF-8"?>
<g3d version="1.0">

  <metadata>
    <title>Canonical Character</title>
    <author>G3D Reference Samples</author>
    <createdAt>2026-10-20T14:30:00Z</createdAt>
    <generator name="g3d-exporter" version="1.0"/>
    <license src="LICENSE"/>
  </metadata>

  <assets>
    <textureSet id="albedo_set">
      <image assetId="albedo_astc" vkFormat="VK_FORMAT_ASTC_4x4_SRGB_BLOCK"  when="formatSupported(ASTC_4x4_SRGB)" prefer="30"/>
      <image assetId="albedo_etc2" vkFormat="VK_FORMAT_ETC2_RGB8_SRGB_BLOCK" when="formatSupported(ETC2_RGB8_SRGB)" prefer="20"/>
      <image assetId="albedo_rgba" vkFormat="VK_FORMAT_R8G8B8A8_SRGB"        when="*" default="true"/>
    </textureSet>
    <textureSet id="orm_set">
      <image assetId="orm_astc" vkFormat="VK_FORMAT_ASTC_8x8_UNORM_BLOCK" when="formatSupported(ASTC_8x8_UNORM)" prefer="30"/>
      <image assetId="orm_rgba" vkFormat="VK_FORMAT_R8G8B8A8_UNORM"       when="*" default="true"/>
    </textureSet>
    <textureSet id="normal_set">
      <image assetId="normal_astc" vkFormat="VK_FORMAT_ASTC_4x4_UNORM_BLOCK" when="*" default="true"/>
    </textureSet>
    <textureSet id="emissive_set">
      <image assetId="emissive_array_astc" vkFormat="VK_FORMAT_ASTC_4x4_SRGB_BLOCK" when="formatSupported(ASTC_4x4_SRGB)" prefer="30"/>
      <image assetId="emissive_array_rgba" vkFormat="VK_FORMAT_R8G8B8A8_SRGB"       when="*" default="true"/>
    </textureSet>

    <asset id="albedo_astc"    type="texture" src="textures/albedo_astc.ktx2"/>
    <asset id="albedo_etc2"    type="texture" src="textures/albedo_etc2.ktx2"/>
    <asset id="albedo_rgba"    type="texture" src="textures/albedo_rgba.ktx2"/>
    <asset id="orm_astc"       type="texture" src="textures/orm_astc.ktx2"/>
    <asset id="orm_rgba"       type="texture" src="textures/orm_rgba.ktx2"/>
    <asset id="normal_astc"    type="texture" src="textures/normal_astc.ktx2"/>
    <asset id="emissive_array_astc" type="texture" src="textures/emissive_array_astc.ktx2" kind="2dArray"/>
    <asset id="emissive_array_rgba" type="texture" src="textures/emissive_array_rgba.ktx2" kind="2dArray"/>
  </assets>

  <skeletons>
    <skeleton id="rig" nodes="hips spine head arm_l arm_r">
      <joint id="hips"  parent=""/>
      <joint id="spine" parent="hips"/>
      <joint id="head"  parent="spine"/>
      <joint id="arm_l" parent="spine"/>
      <joint id="arm_r" parent="spine"/>
      <inverseBindMatrices count="5" view="v_ibm" componentType="float32"/>
    </skeleton>
    <skin id="body_skin" skeleton="rig">
      <bind node="hips" mode="linear"/>
    </skin>
  </skeletons>

  <mesh>
    <pool src="character.bin" byteLength="21248">
      <buffer id="buf_static" byteOffset="0"     byteLength="15160" align="256"/>
      <buffer id="buf_morph"  byteOffset="15168" byteLength="5760"  align="16"/>
      <buffer id="buf_skin"   byteOffset="20928" byteLength="320"   align="16"/>
    </pool>

    <bufferView id="v_body_verts" buffer="buf_static" byteOffset="0"      byteLength="9216"  byteStride="36" target="arrayBuffer"/>
    <bufferView id="v_body_idx"   buffer="buf_static" byteOffset="12160"  byteLength="1200"  byteStride="0"  target="elementArrayBuffer"/>
    <bufferView id="v_face_pos"   buffer="buf_static" byteOffset="9216"   byteLength="1536"  byteStride="0"  target="arrayBuffer"/>
    <bufferView id="v_face_nrm"   buffer="buf_static" byteOffset="10752"  byteLength="384"   byteStride="0"  target="arrayBuffer"/>
    <bufferView id="v_face_uv0"   buffer="buf_static" byteOffset="11136"  byteLength="1024"  byteStride="0"  target="arrayBuffer"/>
    <bufferView id="v_face_idx"   buffer="buf_static" byteOffset="13360"  byteLength="1800"  byteStride="0"  target="elementArrayBuffer"/>
    <bufferView id="v_morph_pos"  buffer="buf_morph"  byteOffset="0"      byteLength="4608"  byteStride="0"  target="arrayBuffer"/>
    <bufferView id="v_morph_nrm"  buffer="buf_morph"  byteOffset="4608"   byteLength="1152"  byteStride="0"  target="arrayBuffer"/>
    <bufferView id="v_ibm"        buffer="buf_skin"   byteOffset="0"      byteLength="320"   byteStride="0"  target="arrayBuffer"/>

    <geometry id="body">
      <positions count="256" view="v_body_verts" byteOffset="0"  componentType="uint16">
        <quantization offset="-0.6 -0.02 -0.35" scale="1.2 0.88 0.7"
                      min="-0.6 -0.02 -0.35" max="0.6 0.86 0.35"/>
      </positions>
      <normals  count="256" view="v_body_verts" byteOffset="8"  componentType="int8"   normalized="true"/>
      <tangents count="256" view="v_body_verts" byteOffset="12" componentType="int8"   normalized="true"/>
      <uv0      count="256" view="v_body_verts" byteOffset="16" componentType="uint16" normalized="true"/>
      <uv1      count="256" view="v_body_verts" byteOffset="20" componentType="uint16" normalized="true"/>
      <joints0  count="256" view="v_body_verts" byteOffset="24" componentType="uint8"/>
      <weights0 count="256" view="v_body_verts" byteOffset="28" componentType="uint16" normalized="true"/>
      <indices  count="600" view="v_body_idx"   componentType="uint16" topology="triangles"/>
    </geometry>

    <geometry id="face">
      <positions count="128" view="v_face_pos" componentType="float32"/>
      <normals   count="128" view="v_face_nrm" componentType="int8"   normalized="true"/>
      <uv0       count="128" view="v_face_uv0" componentType="float32"/>
      <indices   count="900" view="v_face_idx" componentType="uint16" topology="triangles"/>
      <morph count="3">
        <target id="blink"/>
        <target id="smile"/>
        <target id="brow"/>
        <targetPositions view="v_morph_pos" componentType="float32" count="384"/>
        <targetNormals   view="v_morph_nrm" componentType="int8" normalized="true" count="384"/>
      </morph>
    </geometry>

    <primitive id="body-prim" geometry="body" material="skin_mat" skin="body_skin"/>
    <primitive id="face-prim" geometry="face" material="skin_mat" morphWeights="0 0 0"/>
  </mesh>

  <materials>
    <material id="skin_mat" name="Skin" doubleSided="false" alphaMode="opaque" premultiplied="false">
      <pbr workflow="metallicRoughness">
        <baseColor r="1" g="1" b="1" a="1" colorspace="srgb">
          <texture assetId="albedo_set" texCoord="0"/>
          <transform scale="1 1" offset="0 0" rotation="0"/>
        </baseColor>
        <metallicRoughness>
          <texture assetId="orm_set" texCoord="1" channelG="roughness" channelB="metallic"/>
        </metallicRoughness>
        <metallic value="0"/>
        <roughness value="0.6"/>
        <occlusion strength="0.8">
          <texture assetId="orm_set" texCoord="1" channel="r"/>
        </occlusion>
        <normal scale="1">
          <texture assetId="normal_set" texCoord="0" colorspace="linear"/>
        </normal>
        <emissive r="0" g="0" b="0" strength="1">
          <texture assetId="emissive_set" texCoord="0" layer="1" colorspace="srgb"/>
        </emissive>
      </pbr>
    </material>
  </materials>

  <cameras>
    <camera id="cam_main" type="perspective">
      <yfov value="0.7854"/>
      <aspectRatio value="1.7778"/>
      <znear value="0.1"/>
      <zfar value="12"/>
    </camera>
  </cameras>

  <lights>
    <light id="key" type="spot">
      <color r="1" g="0.95" b="0.9"/>
      <intensity value="1200"/>
      <range value="8"/>
      <innerConeAngle value="0.3"/>
      <outerConeAngle value="0.5"/>
    </light>
  </lights>

  <animations>
    <animation id="idle" duration="2.5">
      <sampler id="spine_rot">
        <input  count="3">0 1.25 2.5</input>
        <output count="3">0 0 0 1  0 0.049979 0 0.99875  0 0 0 1</output>
      </sampler>
      <sampler id="face_morph">
        <input  count="3">0 1.25 2.5</input>
        <output count="3">0 0 0  0.8 0 0  0 0 0</output>
      </sampler>
      <channel target="spine"      property="rotation"     sampler="spine_rot"  interpolation="linear"/>
      <channel target="face-prim"  property="morphWeights" sampler="face_morph" interpolation="linear"/>
    </animation>
  </animations>

  <collisions>
    <body id="hips_col" node="hips" type="dynamic">
      <shape type="capsule" radius="0.25" height="1.2"/>
    </body>
  </collisions>

  <scene>
    <node id="root">
      <node id="hips" translation="0 0 0">
        <node id="spine" translation="0 0.5 0">
          <node id="head"  translation="0 0.7 0"/>
          <node id="arm_l" translation="-0.4 0.7 0"/>
          <node id="arm_r" translation="0.4 0.7 0"/>
        </node>
        <node id="body"><mesh ref="body-prim"/></node>
        <node id="face"><mesh ref="face-prim"/></node>
      </node>
      <node id="camnode" translation="0 1.4 2.2"><camera ref="cam_main"/></node>
      <node id="keynode" translation="1.5 2.5 1.5"><light ref="key"/></node>
    </node>
  </scene>

</g3d>
